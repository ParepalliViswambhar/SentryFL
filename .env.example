# Required by the API server in Docker Compose
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL
POSTGRES_DB=sentryfl
POSTGRES_USER=sentryfl
POSTGRES_PASSWORD=sentryfl
# DATABASE_URL=postgresql://sentryfl:sentryfl@localhost:5432/sentryfl

# Optional deployment overrides
HTTP_PORT=80
HTTPS_PORT=443
CORS_ORIGIN=https://localhost
PYTHON_BACKEND_URL=http://python-backend:5000
CACHE_TTL_SECONDS=300
