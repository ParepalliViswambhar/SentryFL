# Required by the API server in Docker Compose
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB (experiment/user/config/audit persistence for the API server)
MONGO_DB=sentryfl
MONGO_USER=sentryfl
MONGO_PASSWORD=replace-with-a-database-password

# Optional deployment overrides
HTTP_PORT=80
HTTPS_PORT=443
CORS_ORIGIN=https://localhost
